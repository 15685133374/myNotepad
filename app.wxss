page {
  background: #f1f4f2;
  color: #16281f;
  font-size: 28rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(12, 59, 46, 0.05);
}

.btn {
  border-radius: 12rpx;
  font-size: 28rpx;
}
.btn::after { border: none; }
.btn-green { background: #0C3B2E; color: #fff; }
.btn-plain { background: #fff; color: #0C3B2E; border: 1rpx solid #0C3B2E; }
.btn-danger { background: #fff; color: #d4380d; border: 1rpx solid #d4380d; }
.btn-grey { background: #f4f6f5; color: #333; }
.btn-light { background: rgba(255,255,255,.16); color: #fff; }

.tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}
.tag-cash { background: #fdf3e3; color: #b7791f; }
.tag-wechat { background: #e6f4ea; color: #1a7f37; }

.amount { color: #b7791f; font-weight: 700; }
.muted { color: #8a978f; font-size: 24rpx; }
.hl { color: #d4380d; font-weight: 700; }
.danger { color: #d4380d; }

.row { display: flex; align-items: center; }
.between { justify-content: space-between; }

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #0C3B2E;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, .45);
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-box {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  text-align: center;
}
.modal-actions { display: flex; margin-top: 28rpx; }
.half { flex: 1; margin: 0 10rpx; }
.block { width: 100%; margin-top: 16rpx; font-size: 28rpx; box-sizing: border-box; }

.input {
  background: #f4f6f5;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  margin-top: 16rpx;
}

.empty {
  text-align: center;
  color: #8a978f;
  padding: 80rpx 0;
  font-size: 26rpx;
}

.error { color: #d4380d; font-size: 24rpx; margin-top: 12rpx; text-align: center; }
