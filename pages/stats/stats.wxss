.head {
  background: #0C3B2E;
  padding: 40rpx 32rpx 48rpx;
  color: #fff;
}
.head-stats { display: flex; }
.head-item { flex: 1; }
.head-num { font-size: 40rpx; font-weight: 700; }
.head-num.small { font-size: 28rpx; }
.sub { font-size: 22rpx; font-weight: 400; opacity: .75; }
.muted-light { color: rgba(255,255,255,.7); font-size: 24rpx; margin-top: 6rpx; }
.balance-line { margin-top: 28rpx; font-size: 26rpx; color: #ffd591; }

.chart-title { font-size: 28rpx; font-weight: 600; margin-bottom: 24rpx; }

.bar-chart {
  display: flex;
  align-items: flex-end;
  height: 300rpx;
}
.bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}
.bars {
  display: flex;
  align-items: flex-end;
}
.bar {
  width: 22rpx;
  border-radius: 6rpx 6rpx 0 0;
  margin: 0 5rpx;
  min-height: 4rpx;
}
.bar-in { background: #0C3B2E; }
.bar-out { background: #d8a94e; }
.bar-label { font-size: 22rpx; color: #8a978f; margin-top: 10rpx; }

.legend {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #4a5a52;
  margin-right: 28rpx;
  margin-bottom: 10rpx;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}
.dot-in { background: #0C3B2E; }
.dot-out { background: #d8a94e; }

.pie-wrap { display: flex; justify-content: center; }
.pie-canvas { width: 420rpx; height: 420rpx; }
