.field { margin-bottom: 28rpx; }
.label { font-size: 26rpx; color: #4a5a52; }

.picker-view { color: #16281f; }

.suggest-list {
  background: #fff;
  border: 1rpx solid #e3e8e5;
  border-radius: 12rpx;
  margin-top: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, .08);
}
.suggest-item {
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f0f2f1;
}
.suggest-item:last-child { border-bottom: none; }

.pay-types { display: flex; margin-top: 16rpx; }
.pay-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  background: #F8F9FB;
  font-size: 28rpx;
  color: #4a5a52;
}
.pay-item + .pay-item { margin-left: 20rpx; }
.pay-item.active {
  background: #4CAF50;
  color: #fff;
}

.save-btn {
  margin: 24rpx;
}
