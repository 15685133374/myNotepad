.head {
  background: #4CAF50;
  padding: 24rpx 24rpx 40rpx;
  color: #fff;
}
.head-top { display: flex; align-items: center; }
.search-bar {
  flex: 1;
  background: rgba(255, 255, 255, .16);
  border-radius: 12rpx;
  padding: 14rpx 24rpx;
  display: flex;
  align-items: center;
}
.search-icon { font-size: 26rpx; margin-right: 12rpx; opacity: .8; }
.search-input { flex: 1; font-size: 26rpx; color: #fff; }
.search-input .placeholder { color: rgba(255,255,255,.7); }
.year-picker {
  margin-left: 20rpx;
  background: rgba(255, 255, 255, .16);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  white-space: nowrap;
}
.total { font-size: 56rpx; font-weight: 700; margin-top: 28rpx; }
.muted-light { color: rgba(255,255,255,.7); font-size: 24rpx; margin-top: 10rpx; }

.range-row { display: flex; margin-top: 24rpx; }
.range-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 12rpx 0;
  border-radius: 24rpx;
  color: rgba(255,255,255,.75);
}
.range-item.active {
  background: rgba(255,255,255,.18);
  color: #fff;
  font-weight: 600;
}
.range-summary { margin-top: 16rpx; }

.record { display: flex; align-items: center; }
.record-info { flex: 1; margin-left: 20rpx; overflow: hidden; }
.record-name { font-size: 30rpx; font-weight: 600; }

.fab {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: 48rpx;
  background: #4CAF50;
  color: #fff;
  padding: 22rpx 72rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, .35);
  z-index: 10;
}
