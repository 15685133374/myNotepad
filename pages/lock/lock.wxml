<view class="wrap">
  <view class="lock-icon">🔒</view>
  <view class="title">{{mode === 'set' ? '设置密码锁' : '输入密码解锁'}}</view>
  <view class="desc">{{mode === 'set' ? '开启后，每次进入小程序都需要验证密码' : '请输入你设置的密码'}}</view>

  <input class="pwd-input" password type="number" maxlength="12" placeholder="请输入密码" placeholder-style="color:#999" cursor-color="#327E36" value="{{pwd}}" bindinput="onPwd" focus />
  <input wx:if="{{mode === 'set'}}" class="pwd-input" password type="number" maxlength="12" placeholder="请再次输入密码" placeholder-style="color:#999" cursor-color="#327E36" value="{{pwd2}}" bindinput="onPwd2" />

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <button class="btn btn-green block confirm-btn" bindtap="confirm">{{mode === 'set' ? '开启密码锁' : '解锁'}}</button>

  <view wx:if="{{mode === 'unlock'}}" class="forgot" bindtap="resetAll">忘记密码？清空数据并重置</view>
</view>
