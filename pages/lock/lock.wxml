<view class="wrap">
  <view class="lock-icon">🔒</view>
  <view class="title">{{mode === 'set' ? '设置密码锁' : '输入密码解锁'}}</view>
  <view class="desc">{{mode === 'set' ? '开启后，每次进入小程序都需要验证密码' : '请输入你设置的密码'}}</view>

  <!-- 指纹/面容解锁 -->
  <view wx:if="{{mode === 'unlock' && soterEnabled && lockCountdown === 0}}" class="soter-section">
    <button class="soter-btn" bindtap="trySoter">
      <text class="soter-icon">👆</text>
      <text>生物识别解锁</text>
    </button>
    <view class="soter-divider">或输入密码</view>
  </view>

  <input class="pwd-input" password type="number" maxlength="12" placeholder="请输入密码" placeholder-style="color:#999" cursor-color="#327E36" value="{{pwd}}" bindinput="onPwd" disabled="{{lockCountdown > 0}}" />
  <input wx:if="{{mode === 'set'}}" class="pwd-input" password type="number" maxlength="12" placeholder="请再次输入密码" placeholder-style="color:#999" cursor-color="#327E36" value="{{pwd2}}" bindinput="onPwd2" />

  <!-- 安全问题（设置密码时） -->
  <view wx:if="{{mode === 'set'}}" class="security-section">
    <view class="security-label">安全问题（忘记密码时用于验证身份）</view>
    <picker bindchange="onSecurityQuestionChange" value="0" range="{{securityOptions}}">
      <view class="picker-item">{{securityQuestion || '请选择安全问题'}}</view>
    </picker>
    <input class="pwd-input security-answer" type="text" maxlength="20" placeholder="请输入答案" placeholder-style="color:#999" value="{{securityAnswer}}" bindinput="onSecurityAnswer" />
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <button class="btn btn-green block confirm-btn" bindtap="confirm" disabled="{{lockCountdown > 0}}">{{mode === 'set' ? '开启密码锁' : '解锁'}}</button>

  <!-- 忘记密码入口 -->
  <view wx:if="{{mode === 'unlock' && !showSecurityVerify}}" class="forgot" bindtap="resetAll">忘记密码？验证身份并重置</view>

  <!-- 安全问题验证界面 -->
  <view wx:if="{{showSecurityVerify}}" class="security-verify">
    <view class="security-verify-title">安全问题验证</view>
    <view class="security-verify-q">{{verifyQuestion}}</view>
    <input class="pwd-input" type="text" maxlength="20" placeholder="请输入答案" placeholder-style="color:#999" value="{{verifyAnswer}}" bindinput="onVerifyAnswer" />
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view class="security-verify-btns">
      <button class="btn-cancel" bindtap="cancelSecurityVerify">取消</button>
      <button class="btn btn-green" bindtap="confirmSecurityVerify">验证</button>
    </view>
  </view>
</view>
