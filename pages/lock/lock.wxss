page { background: #0C3B2E; }

.wrap {
  padding: 120rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.lock-icon { font-size: 96rpx; }
.title { color: #fff; font-size: 40rpx; font-weight: 700; margin-top: 32rpx; }
.desc { color: rgba(255,255,255,.7); font-size: 24rpx; margin-top: 12rpx; }

.pwd-input {
  width: 100%;
  box-sizing: border-box;
  background: rgba(255,255,255,.14);
  border-radius: 12rpx;
  padding: 22rpx 28rpx;
  color: #fff;
  font-size: 30rpx;
  margin-top: 28rpx;
}

.error { color: #ffb4a2; margin-top: 20rpx; }

.confirm-btn { margin-top: 40rpx; background: #fff; color: #0C3B2E; font-weight: 600; }

.forgot {
  color: rgba(255,255,255,.6);
  font-size: 24rpx;
  margin-top: 40rpx;
  text-decoration: underline;
}
