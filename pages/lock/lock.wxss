page { background: #4CAF50; }

.wrap {
  padding: 120rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.lock-icon { font-size: 96rpx; }
.title { color: #fff; font-size: 40rpx; font-weight: 700; margin-top: 32rpx; }
.desc { color: rgba(255,255,255,.7); font-size: 24rpx; margin-top: 12rpx; }

.pwd-input {
  width: 100%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 12rpx;
  padding: 22rpx 28rpx;
  color: #333;
  font-size: 30rpx;
  line-height: 40rpx;
  height: 84rpx;
  margin-top: 28rpx;
}

.error { color: #ffb4a2; margin-top: 20rpx; }

.confirm-btn { margin-top: 40rpx; background: #fff; color: #4CAF50; font-weight: 600; }

.forgot {
  color: rgba(255,255,255,.6);
  font-size: 24rpx;
  margin-top: 40rpx;
  text-decoration: underline;
}

.soter-section {
  width: 100%;
  margin-bottom: 16rpx;
}

.soter-btn {
  width: 100%;
  background: rgba(255,255,255,.15);
  border: 2rpx solid rgba(255,255,255,.3);
  border-radius: 12rpx;
  color: #fff;
  font-size: 30rpx;
  padding: 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.soter-btn::after { border: none; }

.soter-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.soter-divider {
  text-align: center;
  color: rgba(255,255,255,.5);
  font-size: 24rpx;
  margin: 24rpx 0 8rpx;
}

/* 安全问题 */
.security-section {
  width: 100%;
  margin-top: 28rpx;
}
.security-label {
  color: rgba(255,255,255,.7);
  font-size: 24rpx;
  margin-bottom: 12rpx;
}
.picker-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 22rpx 28rpx;
  color: #333;
  font-size: 30rpx;
  line-height: 40rpx;
  height: 84rpx;
  box-sizing: border-box;
}
.security-answer {
  margin-top: 16rpx;
}

/* 安全问题验证界面 */
.security-verify {
  width: 100%;
  margin-top: 32rpx;
}
.security-verify-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 20rpx;
}
.security-verify-q {
  color: rgba(255,255,255,.85);
  font-size: 28rpx;
  text-align: center;
  margin-bottom: 20rpx;
}
.security-verify-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}
.btn-cancel {
  flex: 1;
  background: rgba(255,255,255,.2);
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}
.btn-cancel::after { border: none; }
.btn-confirm {
  flex: 1;
  background: #fff;
  color: #4CAF50;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 0;
  text-align: center;
}
.btn-confirm::after { border: none; }
