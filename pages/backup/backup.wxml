<view class="page">
  <!-- 云端同步 -->
  <view class="card" wx:if="{{cloudEnabled}}">
    <view class="section-title">云端同步</view>
    <view class="section-desc">数据自动加密备份到云端，换手机也能恢复</view>
    <view class="sync-status">
      <view class="sync-status-text">
        <block wx:if="{{syncing}}">正在同步...</block>
        <block wx:elif="{{pendingCount > 0}}">{{pendingCount}} 条待同步</block>
        <block wx:else>全部数据已同步 ✓</block>
      </view>
      <view class="sync-time" wx:if="{{lastSyncTime}}">上次同步：{{lastSyncTime}}</view>
    </view>
    <button class="btn btn-green block" bindtap="syncNow" loading="{{syncing}}">
      {{syncing ? '同步中...' : '同步到云端'}}
    </button>
  </view>

  <!-- 本地备份 -->
  <view class="card">
    <view class="section-title">本地备份</view>
    <view class="section-desc">导出数据到剪贴板，可粘贴保存到其他地方；或从备份恢复</view>
    <button class="btn btn-green block" bindtap="exportData">导出数据</button>
    <button class="btn btn-plain block" bindtap="importData">导入数据</button>
  </view>

  <!-- 用户列表 -->
  <view class="card" wx:if="{{users.length > 1}}">
    <view class="section-title">用户列表</view>
    <view class="section-desc">本设备上使用过的用户（家庭共享）</view>
    <view class="user-list">
      <view wx:for="{{users}}" wx:key="openid" class="user-item" bindtap="switchUser" data-openid="{{item.openid}}" data-nickname="{{item.nickname}}">
        <image wx:if="{{item.avatar}}" class="user-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
        <view wx:else class="user-avatar-placeholder">{{item.nickname[0]}}</view>
        <view class="user-info">
          <view class="user-name">{{item.nickname}}</view>
          <view class="user-id">{{item.openid}}</view>
        </view>
        <view class="user-action">查看数据 ›</view>
      </view>
    </view>
  </view>

  <!-- 导出数据弹窗 -->
  <view wx:if="{{showExport}}" class="modal-mask" bindtap="closeExport">
    <view class="modal-box export-modal" catchtap="">
      <view class="modal-title">导出数据</view>
      <view class="export-tip">请复制以下 JSON 数据并保存</view>
      <textarea class="export-textarea" value="{{exportData}}" readonly maxlength="-1"></textarea>
      <view class="modal-actions">
        <button class="btn btn-grey half" bindtap="closeExport">关闭</button>
        <button class="btn btn-green half" bindtap="copyExportData">复制</button>
      </view>
    </view>
  </view>
</view>
