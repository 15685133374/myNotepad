page { background: #0C3B2E; }

.search-bar {
  margin: 24rpx;
  background: rgba(255, 255, 255, .16);
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
}
.search-icon { font-size: 28rpx; margin-right: 12rpx; opacity: .8; }
.search-placeholder { color: rgba(255, 255, 255, .7); font-size: 26rpx; }

.create-btn {
  margin: 0 24rpx 8rpx;
  background: rgba(255, 255, 255, .12);
  border: 1rpx dashed rgba(255, 255, 255, .4);
  color: #fff;
  text-align: center;
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
}

.book-card { margin-top: 16rpx; }
.book-name { font-size: 32rpx; font-weight: 600; }
