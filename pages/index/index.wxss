page { background: #4CAF50; }

.search-bar {
  margin: 24rpx;
  background: rgba(255, 255, 255, .16);
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: center;
}
.search-icon { font-size: 28rpx; margin-right: 12rpx; opacity: .8; }
.search-placeholder { color: rgba(255, 255, 255, .7); font-size: 26rpx; }

.create-btn {
  margin: 0 24rpx 16rpx;
  background: #fff;
  border: 1rpx solid #4CAF50;
  color: #4CAF50;
  text-align: center;
  border-radius: 48rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, .2);
}

.empty { color: #fff; }
.empty view { color: #fff; }

.book-card { margin-top: 16rpx; }
.book-name { font-size: 32rpx; font-weight: 600; }

.date-picker {
  margin-top: 16rpx;
}
.date-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #F8F9FB;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
}
.date-label {
  color: #4a5a52;
  font-size: 28rpx;
}
.date-value {
  color: #16281f;
  font-size: 28rpx;
}
