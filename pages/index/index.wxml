<view class="search-bar" bindtap="goSearch">
  <text class="search-icon">🔍</text>
  <text class="search-placeholder">搜索礼簿名称...</text>
</view>

<view class="create-btn" bindtap="openCreate">+ 创建礼簿</view>

<view wx:if="{{books.length === 0}}" class="empty">
  <view>还没有礼簿</view>
  <view style="margin-top:10rpx;">点击上方按钮创建你的第一个礼簿</view>
</view>

<view wx:for="{{books}}" wx:key="id" class="card book-card" bindtap="goDetail" data-id="{{item.id}}">
  <view class="row between">
    <view class="book-name">{{item.name}}</view>
    <view class="muted">{{item.dateText}}</view>
  </view>
  <view class="row between" style="margin-top:24rpx;">
    <view>
      <view class="muted">礼金总收入</view>
      <view class="amount" style="font-size:38rpx;">¥{{item.totalText}}</view>
    </view>
    <view class="muted">{{item.countText}}</view>
  </view>
  <view class="row" style="margin-top:24rpx;">
    <button class="btn btn-plain half" size="mini" catchtap="onBookAction" data-id="{{item.id}}" data-name="{{item.name}}">管理礼簿</button>
    <button class="btn btn-green half" size="mini">进入礼簿</button>
  </view>
</view>

<view wx:if="{{showCreate}}" class="modal-mask">
  <view class="modal-box" catchtap="">
    <view class="modal-title">创建礼簿</view>
    <input class="input" placeholder="如：儿子婚宴、父亲七十大寿" value="{{newName}}" bindinput="onNameInput" focus maxlength="30" />
    <picker class="date-picker" mode="date" value="{{newDate}}" bindchange="onDateChange">
      <view class="date-display">
        <text class="date-label">日期</text>
        <text class="date-value">{{newDateText}}</text>
      </view>
    </picker>
    <view class="modal-actions">
      <button class="btn btn-grey half" bindtap="closeCreate">取消</button>
      <button class="btn btn-green half" bindtap="confirmCreate">创建</button>
    </view>
  </view>
</view>

<!-- 修改日期弹窗 -->
<view wx:if="{{showEditDate}}" class="modal-mask">
  <view class="modal-box" catchtap="">
    <view class="modal-title">修改日期</view>
    <picker class="date-picker" mode="date" value="{{editDate}}" bindchange="onEditDateChange">
      <view class="date-display">
        <text class="date-label">日期</text>
        <text class="date-value">{{editDateText}}</text>
      </view>
    </picker>
    <view class="modal-actions">
      <button class="btn btn-grey half" bindtap="closeEditDate">取消</button>
      <button class="btn btn-green half" bindtap="confirmEditDate">确定</button>
    </view>
  </view>
</view>
