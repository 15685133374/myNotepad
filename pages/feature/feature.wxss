page {
  background: #4CAF50;
}

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 进度点 */
.progress-bar {
  display: flex;
  justify-content: center;
  padding: 32rpx 0 16rpx;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  margin: 0 6rpx;
  transition: background 0.3s;
}
.dot.active {
  background: #fff;
}

/* 轮播 */
.feature-swiper {
  flex: 1;
  height: 900rpx;
  min-height: 800rpx;
}

.feature-card {
  background: #fff;
  border-radius: 24rpx;
  margin: 24rpx;
  padding: 48rpx 36rpx;
  height: calc(100% - 48rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow-y: auto;
}

.feature-icon {
  font-size: 88rpx;
  margin-bottom: 24rpx;
}

.feature-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #4CAF50;
  margin-bottom: 16rpx;
}

.feature-desc {
  font-size: 28rpx;
  color: #4a5a52;
  line-height: 1.7;
  text-align: center;
  margin-bottom: 36rpx;
}

.feature-points {
  width: 100%;
}

.point-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.point-check {
  color: #4CAF50;
  font-size: 28rpx;
  font-weight: 700;
  margin-right: 16rpx;
  flex-shrink: 0;
  line-height: 1.6;
}

.point-text {
  font-size: 28rpx;
  color: #16281f;
  line-height: 1.6;
  flex: 1;
}

/* 底部指示器 */
.nav-indicator {
  text-align: center;
  color: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
  padding: 24rpx 0 48rpx;
}
