.field { margin-bottom: 28rpx; }
.label { font-size: 26rpx; color: #4a5a52; }

.suggest-list {
  background: #fff;
  border: 1rpx solid #e3e8e5;
  border-radius: 12rpx;
  margin-top: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(12, 59, 46, .1);
}
.suggest-item {
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f0f2f1;
}
.suggest-item:last-child { border-bottom: none; }

.warning {
  color: #b7791f;
  background: #fdf3e3;
  font-size: 24rpx;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin-top: 12rpx;
}

.pay-types { display: flex; margin-top: 16rpx; }
.pay-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  background: #f4f6f5;
  font-size: 28rpx;
  color: #4a5a52;
}
.pay-item + .pay-item { margin-left: 20rpx; }
.pay-item.active {
  background: #0C3B2E;
  color: #fff;
}

.save-btn {
  margin: 24rpx;
}
