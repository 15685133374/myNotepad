.head {
  background: #4CAF50;
  padding: 40rpx 32rpx 48rpx;
  color: #fff;
}
.head-name { font-size: 40rpx; font-weight: 700; }
.head-stats { display: flex; margin-top: 32rpx; }
.head-item { flex: 1; }
.head-num { font-size: 32rpx; font-weight: 700; }
.head-num.green { color: #C8E6C9; }
.head-num.orange { color: #ffd591; }
.muted-light { color: rgba(255,255,255,.7); font-size: 24rpx; margin-top: 6rpx; }

.tabs {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #4a5a52;
  border-bottom: 4rpx solid transparent;
}
.tab.active {
  color: #4CAF50;
  font-weight: 600;
  border-bottom-color: #4CAF50;
}

.record { display: flex; align-items: center; }
.record-info { flex: 1; }
